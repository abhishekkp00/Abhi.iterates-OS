# ─────────────────────────────────────────────────────────────
# AbhiIterates.OS — Frontend Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────

# Backend API base URL (including /api/v1 prefix, no trailing slash)
VITE_API_URL=http://localhost:8080/api/v1

# UPI Virtual Payment Address for marketplace payments
VITE_UPI_ID=yourname@upi
