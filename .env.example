# ═══════════════════════════════════════════════════════════════════════════════
# .env.example — AbhiIterates.OS Environment Variable Template
# Copy this file to .env and fill in your own configuration.
# NEVER commit .env files containing production secrets to version control.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Database (PostgreSQL 16 + pgvector) ─────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/abhi_iterates_os
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=replace_with_secure_postgres_password
POSTGRES_DB=abhi_iterates_os
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_secure_postgres_password
POSTGRES_PORT=5432

# ── Backend Server ─────────────────────────────────────────────────────────────
PORT=8080
SPRING_PROFILES_ACTIVE=dev
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5180,http://localhost:3000

# ── Frontend (Vite Client) ──────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8080/api/v1
FRONTEND_PORT=3000

# ── Security & JWT Authentication ──────────────────────────────────────────────
# Generate a strong 256-bit (32+ byte) key using: openssl rand -base64 64
JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_bytes_long_key
JWT_EXPIRATION_MS=900000          # 15 minutes (default)
JWT_REFRESH_EXPIRATION_MS=604800000 # 7 days (default)

# ── Primary Admin Seed Account ──────────────────────────────────────────────────
# Required on first startup to seed the initial system administrator account.
ADMIN_EMAIL=admin@abhiiterates.os
ADMIN_PASSWORD=ReplaceWithStrongAdminP@ss123!

# ── Google OAuth2 Authentication ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── AI Provider (Groq API — OpenAI-compatible REST endpoint) ──────────────────
# The Groq API key MUST exist strictly on the backend. Never send to frontend.
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai
GROQ_MODEL=llama-3.3-70b-versatile
SPRING_AI_TEMPERATURE=0.7
SPRING_AI_MAX_TOKENS=2048

# ── RAG Document Vector Embeddings (OpenAI REST endpoint) ──────────────────────
# Note: Groq does not provide text embeddings. OpenAI endpoint is used for RAG embeddings.
OPENAI_API_KEY=your_openai_api_key_for_embeddings
OPENAI_BASE_URL=https://api.openai.com
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSIONS=1536
RAG_ENABLED=true
RAG_CHUNK_SIZE=800
RAG_RETRIEVAL_TOP_K=5
RAG_RETRIEVAL_SIMILARITY_THRESHOLD=0.60

# ── Campus Marketplace / Payments ─────────────────────────────────────────────
# Note: Automatic gateway processing is not implemented. Displays static UPI ID.
UPI_ID=yourname@upi

# ── Cloudinary Media Storage (Optional Fallback) ──────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
